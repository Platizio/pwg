# Dependencies — never commit these
node_modules/

# Build output
dist/
dist-ssr/

# Local env files
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db

# SSR bundle emitted by scripts/prerender.mjs
.ssr

# Local agent tooling state
.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version

# Credentials — defensive. The ViewTrade UAT keys live outside this repo
# (Global_API/) and must stay there. These patterns exist so an accidental
# copy-paste into the working tree cannot be committed.
Global_API/
**/credentials/
*_Credentials.txt
client-url-config.json
*.pem
*.key

# TypeScript incremental build info
*.tsbuildinfo

# The market terminal is a separate Next.js app with its own .git, its own
# lockfile and 2.4GB of node_modules and build output. Committing it from here
# would create a gitlink to a repo that has no remote — Vercel or Render would
# clone an empty directory. It ships as its own service; see the deployment
# task in the plan.
screener/
