# Dependencies — never commit these
node_modules/

# Build output
dist/
dist-ssr/
.next/
next-env.d.ts

# Local env files
.env
.env.local
.env.*.local
# .env.production was not covered by the patterns above, so it would have been
# committed. Vercel holds production values; nothing needs it in git.
.env.production
.env.development

# Supabase CLI local state. .temp/pooler-url contains a database connection
# string with the password in it — this must never be committed.
supabase/.temp/
supabase/.branches/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db

# SSR bundle emitted by scripts/prerender.mjs
.ssr

# Local agent tooling state
.claude-flow/
.impeccable-terminal/
.claude/proven-config.json
.claude/.proven-config-version

# Credentials — defensive. The ViewTrade UAT keys live outside this repo
# (Global_API/) and must stay there. These patterns exist so an accidental
# copy-paste into the working tree cannot be committed.
Global_API/
**/credentials/
*_Credentials.txt
client-url-config.json
*.pem
*.key

# TypeScript incremental build info
*.tsbuildinfo

# The market terminal used to live in screener/, with its own .gitignore that
# covered screener/node_modules, screener/.next and screener/Global_API. That
# directory has now been flattened into the repository root, and its nested
# .gitignore went with it — so those three rules had to be restated above, at
# the root, or the 1.8 GB .next build output would land in the next commit.
# node_modules/ and Global_API/ were already rooted here; .next/ was not.

# Scratch output from MCP browser tooling during review runs.
.playwright-mcp/

# Impeccable design-skill local state: hook cache, config and review captures.
# Tooling output, not project source (5.9MB of screenshots).
.impeccable/
