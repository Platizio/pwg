# Dependencies — never commit these
node_modules/

# Build output
dist/
dist-ssr/

# Local env files
.env
.env.local
.env.*.local
# .env.production was not covered by the patterns above, so it would have been
# committed. Vercel holds production values; nothing needs it in git.
.env.production
.env.development

# Supabase CLI local state. .temp/pooler-url contains a database connection
# string with the password in it — this must never be committed.
supabase/.temp/
supabase/.branches/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db

# SSR bundle emitted by scripts/prerender.mjs
.ssr

# Local agent tooling state
.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version

# Credentials — defensive. The ViewTrade UAT keys live outside this repo
# (Global_API/) and must stay there. These patterns exist so an accidental
# copy-paste into the working tree cannot be committed.
Global_API/
**/credentials/
*_Credentials.txt
client-url-config.json
*.pem
*.key

# TypeScript incremental build info
*.tsbuildinfo

# The market terminal (screener/) used to be excluded here: it carried its own
# .git, so committing it would have created a gitlink to a repo with no remote,
# and a deploy would have cloned an empty directory. It is now flattened into
# this repository, so it is tracked like any other directory.
#
# Its own screener/.gitignore still applies — git honours nested ignore files —
# which is what keeps screener/node_modules, screener/.next and, critically,
# screener/Global_API (live UAT credentials) out of every commit. The
# Global_API/ and node_modules/ rules above cover it a second time, at any depth.

# Scratch output from MCP browser tooling during review runs.
.playwright-mcp/
