{
  "name": "platizio-global",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:support && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --test \"tests/**/*.test.ts\"",
    "validate:support": "node scripts/validate-support-content.mjs",
    "webp": "node scripts/convert-webp.mjs",
    "probe": "node --conditions=react-server --env-file=.env.local scripts/probe.mts",
    "build:master": "node --conditions=react-server --env-file=.env.local scripts/build-master.mts",
    "build:sectors": "node --conditions=react-server --env-file=.env.local scripts/build-sectors.mts",
    "build:baseline": "node --conditions=react-server --env-file=.env.local scripts/build-baseline.mts",
    "build:returns": "node --conditions=react-server --env-file=.env.local scripts/build-returns.mts",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "probe:stream": "node --conditions=react-server --env-file=.env.local scripts/probe-stream.mts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lightweight-charts": "^5.2.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "cobe": "^0.6.3",
    "framer-motion": "^13.1.1",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "sharp": "^0.34.5"
  }
}
