    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "sharp": "^0.34.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
